# GBNF grammar for interview-plan.schema.json
# Forces output of a complete 5-10 step project roadmap

root ::= "{" ws steps-field "," ws total-steps-field "," ws summary-field ws "}"

steps-field       ::= "\"steps\"" ws ":" ws steps-array
total-steps-field ::= "\"total_steps\"" ws ":" ws integer
integer           ::= [0-9] [0-9]?
summary-field     ::= "\"summary\"" ws ":" ws string

steps-array ::= "[" ws step-obj (ws "," ws step-obj)* ws "]"

step-obj ::= "{" ws
  "\"step\"" ws ":" ws integer ws "," ws
  "\"title\"" ws ":" ws string ws "," ws
  "\"description\"" ws ":" ws string ws "," ws
  "\"methodology\"" ws ":" ws string ws
  (ws "," ws "\"estimated_duration\"" ws ":" ws string)?
  (ws "," ws "\"deliverable\"" ws ":" ws string)?
ws "}"

string ::= "\"" string-char* "\""
string-char ::=
  [^"\\"\x7F\x00-\x1F]
  | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])

ws ::= ([ \t\n\r] ws)?
