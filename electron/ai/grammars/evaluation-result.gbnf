# GBNF grammar for evaluation-result.schema.json
# Structured step progress evaluation

root ::= "{" ws
  "\"is_valid\"" ws ":" ws boolean ws "," ws
  "\"feedback\"" ws ":" ws string ws "," ws
  "\"suggestions\"" ws ":" ws string-array ws "," ws
  "\"ready_to_advance\"" ws ":" ws boolean ws "," ws
  "\"score\"" ws ":" ws number
  (ws "," ws "\"strengths\"" ws ":" ws string-array)?
ws "}"

string-array ::= "[" ws (string (ws "," ws string)*)? ws "]"
boolean ::= "true" | "false"
number ::= [0-9] [0-9]? [0-9]?

string ::= "\"" string-char* "\""
string-char ::=
  [^"\\"\x7F\x00-\x1F]
  | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])

ws ::= ([ \t\n\r] ws)?
