# GBNF grammar for desirability-evaluation.schema.json
# Initial desirability-only evaluation (not full DVF)

root ::= "{" ws
  "\"stage\"" ws ":" ws "\"initial_desirability\"" ws "," ws
  "\"score\"" ws ":" ws number ws "," ws
  "\"problem_clarity\"" ws ":" ws dimension ws "," ws
  "\"demand_strength\"" ws ":" ws dimension ws "," ws
  "\"ready_for_ideation\"" ws ":" ws boolean
  (ws "," ws "\"evidence\"" ws ":" ws finding-array)?
  (ws "," ws "\"assumptions\"" ws ":" ws string-array)?
  (ws "," ws "\"risks\"" ws ":" ws string-array)?
  (ws "," ws "\"recommendations\"" ws ":" ws string-array)?
ws "}"

dimension ::= "{" ws
  "\"summary\"" ws ":" ws string ws "," ws
  "\"score\"" ws ":" ws number
ws "}"

finding-array ::= "[" ws (finding (ws "," ws finding)*)? ws "]"
finding ::= "{" ws
  "\"statement\"" ws ":" ws string ws "," ws
  "\"type\"" ws ":" ws evidence-type
ws "}"
evidence-type ::= "\"evidence\"" | "\"assumption\"" | "\"unknown\"" | "\"requires_validation\""

string-array ::= "[" ws (string (ws "," ws string)*)? ws "]"
boolean ::= "true" | "false"
number  ::= [0-9] [0-9]? [0-9]?

string ::= "\"" string-char* "\""
string-char ::=
  [^"\\"\x7F\x00-\x1F]
  | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])

ws ::= ([ \t\n\r] ws)?
