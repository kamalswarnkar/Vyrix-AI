# GBNF grammar for decision.schema.json
# Continue / Improve / Redesign decision after DVF

root ::= "{" ws
  "\"decision\"" ws ":" ws decision-type ws "," ws
  "\"reasoning\"" ws ":" ws string ws "," ws
  "\"confidence\"" ws ":" ws number ws "," ws
  "\"next_steps\"" ws ":" ws string-array
ws "}"

decision-type ::= "\"continue\"" | "\"improve\"" | "\"redesign\""
string-array ::= "[" ws string (ws "," ws string)* ws "]"
number ::= [0-9] [0-9]? [0-9]?

string ::= "\"" string-char* "\""
string-char ::=
  [^"\\"\x7F\x00-\x1F]
  | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])

ws ::= ([ \t\n\r] ws)?
