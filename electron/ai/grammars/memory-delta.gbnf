# GBNF grammar for memory-delta.schema.json
# Forces a single key-value memory delta with category

root ::= "{" ws
  "\"key\"" ws ":" ws string ws "," ws
  "\"value\"" ws ":" ws string ws "," ws
  "\"category\"" ws ":" ws category
ws "}"

category ::= "\"technical\"" | "\"design\"" | "\"user\"" | "\"timeline\"" | "\"decision\"" | "\"general\""

string ::= "\"" string-char* "\""
string-char ::=
  [^"\\"\x7F\x00-\x1F]
  | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])

ws ::= ([ \t\n\r] ws)?
