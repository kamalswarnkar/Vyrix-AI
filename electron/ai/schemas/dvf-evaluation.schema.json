{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dvf-evaluation",
  "title": "DVFResult",
  "description": "Full Desirability + Viability + Feasibility evaluation after ideation",
  "type": "object",
  "required": ["stage", "version", "desirability", "viability", "feasibility", "overall_score", "recommendation", "ready_for_decision"],
  "additionalProperties": false,
  "properties": {
    "stage": {
      "type": "string",
      "enum": ["dvf_evaluation"]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing version; never overwritten"
    },
    "desirability": { "$ref": "#/definitions/dimension" },
    "viability":    { "$ref": "#/definitions/dimension" },
    "feasibility":  { "$ref": "#/definitions/dimension" },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "recommendation": {
      "type": "string",
      "minLength": 10
    },
    "strengths": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10
    },
    "ready_for_decision": {
      "type": "boolean"
    }
  },
  "definitions": {
    "dimension": {
      "type": "object",
      "required": ["score", "summary"],
      "additionalProperties": false,
      "properties": {
        "score":   { "type": "integer", "minimum": 0, "maximum": 100 },
        "summary": { "type": "string", "minLength": 5 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "type"],
            "additionalProperties": false,
            "properties": {
              "statement": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["evidence", "assumption", "unknown", "requires_validation"]
              }
            }
          },
          "maxItems": 10
        },
        "risks": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 10
        }
      }
    }
  }
}
