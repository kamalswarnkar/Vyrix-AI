{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "memory-delta",
  "title": "MemoryDelta",
  "description": "A single fact or decision to append to global-memory.log",
  "type": "object",
  "required": ["key", "value", "category"],
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "The fact key (e.g., 'Platform', 'TargetUser', 'OutputType')"
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "The fact value"
    },
    "category": {
      "type": "string",
      "enum": ["technical", "design", "user", "timeline", "decision", "general"],
      "description": "Classification of this memory entry"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score from 0-1 (optional)"
    }
  }
}
